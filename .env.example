# ── App ──
# This app's own base URL — used for canonical links and OG/Twitter meta.
VITE_BASE_URL=http://localhost:3000

# ── Backend REST API ──
# Base URL of the REST backend this app talks to.
# VITE_ prefix = exposed to the client (used by the typed fetch client).
VITE_SERVER_URL=http://localhost:3001/api/v1

# Same base URL for server-side usage (SSR / server functions).
SERVER_URL=http://localhost:3001/api/v1
