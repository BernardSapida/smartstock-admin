# ── App ──
# This app's own base URL - used for canonical links and OG/Twitter meta.
VITE_BASE_URL=http://localhost:3000

# ── Backend REST API ──
# Base URL of the REST backend this app talks to.
# VITE_ prefix = exposed to the client (used by the typed fetch client).
VITE_SERVER_URL=http://localhost:3001/api/v1

# Same base URL for server-side usage (SSR / server functions).
SERVER_URL=http://localhost:3001/api/v1

# ── Firestore backup (Option B: client-SDK export) ──
# Credentials of an EXISTING admin account, used only by
# scripts/export-firestore.client.mjs to read & back up the database.
# Put real values in a local .env (gitignored), never commit them.
#   node --env-file=.env scripts/export-firestore.client.mjs
FIREBASE_EXPORT_EMAIL=admin@example.com
FIREBASE_EXPORT_PASSWORD=your-admin-password
