rules_version = '2';

// Firestore Security Rules for the SmartStock project (shared by
// smartstock-admin and inventory-native - one Firebase project, one `users`
// collection, both apps write to Firestore directly with the client SDK).
//
// SCOPE OF THIS FILE: `users/{uid}` gets tight, field-level rules - this is
// the fix for the reported vulnerability ("anyone can sign up and become an
// admin"): without it, a signed-in client can write `role: "admin"`,
// `status: "active"`, `isActive: true` etc. straight to their own doc via
// the Firestore SDK, bypassing every app-level check.
//
// This file makes that impossible: a user can create their own doc only as a
// fresh `status: 'pending'` account, and can never change their own
// role/status/isActive/isArchived/permissions afterwards - only an existing
// active admin can.
//
// Every other top-level collection (inventory, products, recipes, etc.) gets
// a coarse baseline below: any signed-in, approved & active user can read/
// write. This is intentionally coarse, not per-field permission enforcement
// (mapping each collection to the app's `permissions` map - inventoryAdjust,
// staffManage, etc. - is a follow-up hardening pass) - but it's required for
// the app to function at all, since Firestore denies by default for any path
// with no matching rule.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnUid(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function ownUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Any signed-in user whose OWN account has been approved and isn't
    // deactivated/archived - the baseline gate for app data (any role).
    function isActiveUser() {
      return isSignedIn()
        && ownUserDoc().status == 'active'
        && ownUserDoc().isActive == true
        && ownUserDoc().isArchived != true;
    }

    // An existing, approved, active admin - the only party allowed to change
    // another user's role/status/access.
    function isActiveAdmin() {
      return isSignedIn()
        && ownUserDoc().role == 'admin'
        && ownUserDoc().status == 'active'
        && ownUserDoc().isActive == true
        && ownUserDoc().isArchived != true;
    }

    match /users/{uid} {
      // Read your own profile, or any profile if you're an active admin
      // (Settings > Users needs to list everyone).
      allow read: if isOwnUid(uid) || isActiveAdmin();

      // Self-registration: you can only ever create YOUR OWN doc, and only as
      // a fresh pending account - never pre-approved, never someone else's uid.
      allow create: if isOwnUid(uid)
        && request.resource.data.status == 'pending'
        && request.resource.data.role in ['admin', 'staff']
        && request.resource.data.isActive == true
        && request.resource.data.isArchived == false;

      // Admins can change anything (approve/reject/promote/deactivate/archive).
      // A user editing their OWN doc (e.g. saving their name/phone from the
      // profile page) can never move role/status/isActive/isArchived/
      // permissions themselves - those fields must be unchanged in the update.
      allow update: if isActiveAdmin()
        || (
          isOwnUid(uid)
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
          && request.resource.data.isActive == resource.data.isActive
          && request.resource.data.isArchived == resource.data.isArchived
          && request.resource.data.permissions == resource.data.permissions
        );

      allow delete: if isActiveAdmin();
    }

    // Approved/active user (any role) can read/write everything else. The
    // `collection != 'users'` guard is load-bearing: without it, this would
    // also match `users/{uid}` and let any active user overwrite ANY other
    // user's role/status via this broader rule, defeating the tight checks
    // above (Firestore allows a request if ANY matching rule allows it).
    match /{collection}/{document=**} {
      allow read, write: if collection != 'users' && isSignedIn() && isActiveUser();
    }
  }
}
